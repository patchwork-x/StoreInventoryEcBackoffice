@model StoreInventoryEcBackoffice.Web.ViewModels.OrderListViewModel

@{
    ViewData["Title"] = "注文管理";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 fw-bold">注文管理</h1>
            <p class="text-muted mb-0">
                EC注文のステータス、出荷予定、注文金額を確認できます。
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">表示中の注文件数</div>
                    <div class="fs-3 fw-bold">@Model.Orders.Count</div>
                    <div class="small text-muted">orders</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">出荷待ち件数</div>
                    <div class="fs-3 fw-bold">@Model.ShippingWaitingCount</div>
                    <div class="small text-muted">waiting shipment</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">表示中の注文合計金額</div>
                    <div class="fs-3 fw-bold">@Model.TotalAmount.ToString("N0") 円</div>
                    <div class="small text-muted">total amount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">検索条件</h2>
        </div>

        <div class="card-body">
            <form method="get" asp-controller="Orders" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">キーワード</label>
                    <input type="text"
                           name="keyword"
                           value="@Model.Keyword"
                           class="form-control"
                           placeholder="注文番号・顧客名" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">注文ステータス</label>
                    <select name="orderStatus" class="form-select">
                        <option value="">すべて</option>
                        @foreach (var status in Model.OrderStatuses)
                        {
                            if (Model.OrderStatus == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">注文日 From</label>
                    <input type="date"
                           name="fromDate"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">注文日 To</label>
                    <input type="date"
                           name="toDate"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-dark w-100">
                        検索
                    </button>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                        クリア
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">注文一覧</h2>
            <span class="text-muted small">@Model.Orders.Count 件</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>注文番号</th>
                        <th>顧客名</th>
                        <th>注文日時</th>
                        <th>ステータス</th>
                        <th class="text-end">点数</th>
                        <th class="text-end">金額</th>
                        <th>出荷予定</th>
                        <th>出荷完了</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td class="fw-semibold">@order.OrderNumber</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @if (order.OrderStatus == "出荷済み")
                                {
                                    <span class="badge bg-success">@order.OrderStatus</span>
                                }
                                else if (order.OrderStatus == "キャンセル")
                                {
                                    <span class="badge bg-secondary">@order.OrderStatus</span>
                                }
                                else if (order.OrderStatus == "返品対応中")
                                {
                                    <span class="badge bg-warning text-dark">@order.OrderStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@order.OrderStatus</span>
                                }
                            </td>
                            <td class="text-end">@order.ItemCount</td>
                            <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") 円</td>
                            <td>
                                @(order.ShippingDueDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td>
                                @(order.ShippedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Orders.Any())
        {
            <div class="card-body text-center text-muted">
                条件に一致する注文がありません。
            </div>
        }
    </div>
</div>
